{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-paquete/**",
    "**/coverage/**",
    "**/generado/**",
    "**/mockServiceWorker.js"
  ],
  "rules": {
    "no-debugger": "error",
    "react/jsx-key": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/label-has-associated-control": "error"
  }
}
