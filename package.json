{
  "name": "stock",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "22.22.0",
    "pnpm": "10.13.1"
  },
  "scripts": {
    "dev": "pnpm --filter @pingeso/stock-ui dev",
    "build": "pnpm --filter @pingeso/stock-ui build && pnpm --filter @pingeso/stock-ui build:lib",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings && node scripts/verificar-limites.mjs",
    "typecheck": "pnpm --filter @pingeso/stock-ui typecheck",
    "test": "pnpm --filter @pingeso/stock-ui test",
    "test:api": "node scripts/go.mjs test ./...",
    "test:e2e:api": "node scripts/test-e2e.mjs",
    "codegen": "node scripts/codegen.mjs",
    "mock:stock": "npx --yes @stoplight/prism-cli@5.16.0 mock contracts/openapi.yaml --host 127.0.0.1 --port 5122",
    "docker:mocks": "docker compose -f docker-compose.yaml -f docker-compose.mocks.yaml up -d --build",
    "docker:mocks:estado": "docker compose -f docker-compose.yaml -f docker-compose.mocks.yaml ps",
    "docker:mocks:logs": "docker compose -f docker-compose.yaml -f docker-compose.mocks.yaml logs -f backend mocks",
    "docker:mocks:down": "docker compose -f docker-compose.yaml -f docker-compose.mocks.yaml down",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:api && pnpm build"
  },
  "devDependencies": {
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:"
  }
}
