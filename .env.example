# Copiar a .env y completar todos los replace-with-*; no compartir el archivo .env.
POSTGRES_USER=replace-with-stock-user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=stock
DATABASE_URL=postgres://replace-with-stock-user:replace-with-a-long-random-password@postgres:5432/stock?sslmode=disable
API_PORT=8080
API_ENV=dev
AUTH_JWKS_URL=https://replace-with-identidad-host/.well-known/jwks.json
AUTH_ISSUER=https://replace-with-identidad-host
AUTH_AUDIENCE=replace-with-stock-audience
SESSION_COOKIE_NAME=sesion
PRODUCTOS_URL=https://replace-with-productos-host
FRONTEND_URL=http://localhost:5120
BACKEND_URL=http://backend:8080
SPA_DIRECTORY=/srv
TZ=America/Santiago
# Sólo en el ambiente local. Omitir COMPOSE_PROFILES fuera de desarrollo.
COMPOSE_PROFILES=dev
